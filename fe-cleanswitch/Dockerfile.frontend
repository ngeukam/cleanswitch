# Simple React Dockerfile - No Nginx
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Set environment variables for React build
ARG REACT_APP_API_URL=http://localhost/api
ARG REACT_APP_API_GOOGLE_MAP=
ENV REACT_APP_API_URL=${REACT_APP_API_URL}
ENV REACT_APP_API_GOOGLE_MAP=${REACT_APP_API_GOOGLE_MAP}

# Build the React app
RUN npm run build

# Install a simple HTTP server
RUN npm install -g serve

EXPOSE 3000

# Serve the built React app using Node.js serve
CMD ["serve", "-s", "build", "-l", "3000"]