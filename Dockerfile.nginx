FROM nginx:alpine

# Remove default configs
RUN rm -f /etc/nginx/conf.d/*

# Install curl for healthchecks
RUN apk add --no-cache curl

# Copy custom configurations
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/conf.d/* /etc/nginx/conf.d/

# Create certbot directory for ACME challenges
RUN mkdir -p /var/www/certbot

# Create non-root user (optional but recommended for security)
RUN addgroup -g 1001 -S nginxgroup && \
    adduser -S -D -H -u 1001 -h /var/cache/nginx -s /sbin/nologin -G nginxgroup -g nginx nginxuser

# Set proper permissions for SSL certificates
RUN chown -R nginxuser:nginxgroup /var/cache/nginx /var/log/nginx /var/www/certbot && \
    chmod -R 755 /var/www/certbot

# USER nginxuser  # Uncomment for production

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]